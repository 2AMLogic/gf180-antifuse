{
  "netlist": "body.spice",
  "engine": "ngspice",
  "backend": "batch",
  "batch": {
    "runner_version_check": "warn",
    "capacity_wait_s": 1800
  },
  "models": {
    "pdk": "gf180mcuD",
    "lib": "libs.tech/ngspice/sm141064.ngspice"
  },
  "corners": {
    "process": [
      {
        "name": "typical",
        "sections": [
          "typical",
          "moscap_typical",
          "res_typical",
          "diode_typical"
        ]
      },
      {
        "name": "ff",
        "sections": [
          "ff",
          "moscap_ff",
          "res_ff",
          "diode_ff"
        ]
      },
      {
        "name": "ss",
        "sections": [
          "ss",
          "moscap_ss",
          "res_ss",
          "diode_ss"
        ]
      }
    ],
    "supply_v": {
      "vamp": [
        4.0,
        7.6,
        8.4,
        8.8,
        17.6
      ]
    },
    "temperature_c": [
      -40.0,
      27.0,
      125.0
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "2.000000e-09 4.200000e-06 uic"
  },
  "measurements": [
    {
      "name": "vpad_max",
      "spice": ".meas tran vpad_max MAX v(apad)",
      "unit": "V"
    },
    {
      "name": "vpl_max",
      "spice": ".meas tran vpl_max MAX v(apl)",
      "unit": "V"
    },
    {
      "name": "vox_max",
      "spice": ".meas tran vox_max MAX v(dox)",
      "unit": "V"
    },
    {
      "name": "ifil_max",
      "spice": ".meas tran ifil_max MAX v(ifil)",
      "unit": "A"
    },
    {
      "name": "ipad_max",
      "spice": ".meas tran ipad_max MAX v(ipd)",
      "unit": "A"
    },
    {
      "name": "ijn_max",
      "spice": ".meas tran ijn_max MAX v(ijn)",
      "unit": "A"
    }
  ],
  "options": {
    "timeout_s": 300,
    "keep_artifacts": true
  }
}
