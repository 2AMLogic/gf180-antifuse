{
  "netlist": "body.spice",
  "engine": "ngspice",
  "netlist_source": "schematic",
  "models": {
    "pdk": "gf180mcuD",
    "lib": "libs.tech/ngspice/sm141064.ngspice"
  },
  "options": {
    "timeout_s": 300,
    "keep_artifacts": false,
    "stage_model_inputs": false,
    "ngspice_init": [
      "set measureprec=7"
    ]
  },
  "corners": {
    "process": [
      {
        "name": "typical",
        "sections": [
          "typical",
          "moscap_typical"
        ]
      },
      {
        "name": "ff",
        "sections": [
          "ff",
          "moscap_typical"
        ]
      },
      {
        "name": "ss",
        "sections": [
          "ss",
          "moscap_typical"
        ]
      },
      {
        "name": "fs",
        "sections": [
          "fs",
          "moscap_typical"
        ]
      },
      {
        "name": "sf",
        "sections": [
          "sf",
          "moscap_typical"
        ]
      }
    ],
    "supply_v": {
      "vbl": [
        0.9,
        0.9,
        0.9,
        1.0,
        1.0,
        1.0,
        1.1,
        1.1,
        1.1
      ],
      "vwl": [
        3.0,
        3.3,
        3.6,
        3.0,
        3.3,
        3.6,
        3.0,
        3.3,
        3.6
      ]
    },
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis": {
    "kind": "dc",
    "args": "vpl 0 0 1"
  },
  "measurements": [
    {
      "name": "ibl",
      "spice": ".meas dc ibl MAX i(vbl)",
      "unit": "A"
    }
  ]
}
