.options gmin=1.000000e-13
.include ../../../../../design/breakdown/cell_candidates_bd.spice

.param t1=1.000000e-06 tr=1.000000e-07 tw=1.000000e-05
.func af_fe(u) {exp(-1/max(u,1e-6))}
.func af_edge(x) {af_fe(min(max(x,0),1))/(af_fe(min(max(x,0),1))+af_fe(1-min(max(x,0),1)))}
BSH SH 0 V = 'af_edge((time-t1)/tr) - af_edge((time-t1-tr-tw)/tr)'
VAMP AMP 0 DC 0
BVPP VPP 0 V = 'v(amp)*v(sh)'
RBAL VPP BLM 1.580000e+04
VBL BLM BL DC 0
BWL WL 0 V = '-3.300000e+00 + v(vpp)'
BVB VB 0 V = '3.300000e+00 + v(vpp)'
VPL PL 0 DC 0
XDUT BL WL PL VB cell_candidate3 wcap=1.000000e-06 lcap=1.000000e-06 wacc=3.000000e-07 lacc=5.500000e-07
BDOX DOX 0 V = 'v(xdut.cn)-v(pl)'
BDWC DWC 0 V = 'v(wl)-v(xdut.cn)'
BDWB DWB 0 V = 'v(wl)-v(bl)'
BDBC DBC 0 V = 'v(bl)-v(xdut.cn)'
BDCJ DCJ 0 V = 'v(xdut.cn)-v(vb)'
BDBJ DBJ 0 V = 'v(bl)-v(vb)'
BDGB DGB 0 V = 'v(wl)-v(vb)'
