* gf180-antifuse sim/integrated-transition: slice_i_ii, process corner sf (GENERATED by make_bench.py - do not edit)
* Circuit body for `klt sim`. The MOS and moscap sections come from the request's corner bundle;
* design.ngspice (global switches) and the 10 V LDMOS library's matching section are resolved from
* $PDK_ROOT on whichever host runs the corner. See README.md for the sequence and the assumptions.
.include $PDK_ROOT/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib "$PDK_ROOT/gf180mcuD/libs.tech/ngspice/smbb000149.ngspice" sf
* derived netlists of the design under test (design/netlists/, never copied)
.include ../../../design/netlists/cell_candidate1.spice
.include ../../../design/netlists/cell_candidate2.spice
.include ../../../design/netlists/cell_candidate3.spice
.include ../../../design/netlists/ls_hv06.spice
.include ../../../design/netlists/ls_hv10.spice
.include ../../../design/netlists/pg_n06.spice
.include ../../../design/netlists/pg_n10.spice
.include ../../../design/netlists/leg_interlock.spice
.include ../../../design/netlists/program_leg.spice
.include ../../../design/netlists/read_leg.spice
.include ../../../design/netlists/slice_i_ii.spice

X_dut RSEL_0 RSEL_1 RSEL_2 RSEL_3 CSEL_9 CSEL_10 CSEL_11 CSEL_12 BLG_I PLG_I BLG_II PLG_II VDDH_I VDDH_II vdd 0 slice_i_ii

* ---- supplies. Sweep keys are the V* elements (element name == klt supply_v key) and hold the
* final level; each rail reaches it through a C-infinity power-up ramp (B element), because under
* `uic` every node starts at 0 V and a step would be an unphysical power-up. Nothing is measured
* before 0.5 us. VPP and the bit-line buses are NOT ramped separately: VPP follows VDD up, then
* ramps to Vpk as a scenario event.
Vdd vddk 0 DC 3.3
Vclamp vclampk 0 DC 1.8
Vpk vpk 0 DC 5.0
Bdd vdd 0 V='v(vddk)*af_edge((time+20n)/0.25u)'
Bclamp vclamp 0 V='v(vclampk)*af_edge((time+20n)/0.25u)'
Vddh_I VDDHK_I 0 DC 5.0
Bddh_I VDDH_I 0 V='v(VDDHK_I)*af_edge((time+20n)/0.25u)'
Vplg_I PLG_I 0 DC 0
Vddh_II VDDHK_II 0 DC 5.5
Bddh_II VDDH_II 0 V='v(VDDHK_II)*af_edge((time+20n)/0.25u)'
Vplg_II PLG_II 0 DC 0

* ---- scenario keys: times in microseconds (value in 'volts'), enables are 0/1 ----
Vtvr tvr 0 DC 0.02
Vtcsl tcsl 0 DC 0.0
Vtpe tpe 0 DC 1.8
Vtpf tpf 0 DC 2.8
Vtren tren 0 DC 2.8
Vtdis tdis 0 DC 99.0
Ven_r0 en_r0 0 DC 0
Ven_r1 en_r1 0 DC 0
Ven_r2 en_r2 0 DC 0
Ven_r3 en_r3 0 DC 0
Ven_c9 en_c9 0 DC 0
Ven_c10 en_c10 0 DC 0
Ven_c11 en_c11 0 DC 0
Ven_c12 en_c12 0 DC 0
Vbsel_I bsel_I 0 DC 0
Vbsel_II bsel_II 0 DC 0
Vgfil gfil 0 DC 0

* ---- control waveforms (behavioural; logic highs track VDD like the legs bench) ----
* C-infinity edge f(u)/(f(u)+f(1-u)), f(u)=exp(-1/u): the stock moscap macro stalls on slope
* discontinuities (sim/cell-breakdown-model/README.md, 'Transient convergence (#74)')
.func af_fe(u) {exp(-1/max(u,1e-6))}
.func af_edge(x) {af_fe(min(max(x,0),1))/(af_fe(min(max(x,0),1))+af_fe(1-min(max(x,0),1)))}
* external VPP: idle at VDD, ramps to Vpk starting 0.6 us over tvr (>= 20 ns)
Bvpp vpp 0 V='v(vdd)+(v(vpk)-v(vdd))*af_edge((time-0.6u)/max(v(tvr)*1u,20n))'
Brsel0 RSEL_0 0 V='v(vdd)*v(en_r0)*(af_edge((time-1.2u)/1e-07)-af_edge((time-v(tdis)*1u)/1e-07))'
Brsel1 RSEL_1 0 V='v(vdd)*v(en_r1)*(af_edge((time-1.2u)/1e-07)-af_edge((time-v(tdis)*1u)/1e-07))'
Brsel2 RSEL_2 0 V='v(vdd)*v(en_r2)*(af_edge((time-1.2u)/1e-07)-af_edge((time-v(tdis)*1u)/1e-07))'
Brsel3 RSEL_3 0 V='v(vdd)*v(en_r3)*(af_edge((time-1.2u)/1e-07)-af_edge((time-v(tdis)*1u)/1e-07))'
Bcsel9 CSEL_9 0 V='v(vdd)*v(en_c9)*(af_edge((time-1.2u-v(tcsl)*1u)/1e-07)-af_edge((time-v(tdis)*1u)/1e-07))'
Bcsel10 CSEL_10 0 V='v(vdd)*v(en_c10)*(af_edge((time-1.2u-v(tcsl)*1u)/1e-07)-af_edge((time-v(tdis)*1u)/1e-07))'
Bcsel11 CSEL_11 0 V='v(vdd)*v(en_c11)*(af_edge((time-1.2u-v(tcsl)*1u)/1e-07)-af_edge((time-v(tdis)*1u)/1e-07))'
Bcsel12 CSEL_12 0 V='v(vdd)*v(en_c12)*(af_edge((time-1.2u-v(tcsl)*1u)/1e-07)-af_edge((time-v(tdis)*1u)/1e-07))'
Bpen_i pen_i 0 V='v(vdd)*v(bsel_I)*(af_edge((time-v(tpe)*1u)/1e-07)-af_edge((time-v(tpf)*1u)/1e-07))'
Bren_i ren_i 0 V='v(vdd)*v(bsel_I)*af_edge((time-v(tren)*1u)/1e-07)'
Bpen_ii pen_ii 0 V='v(vdd)*v(bsel_II)*(af_edge((time-v(tpe)*1u)/1e-07)-af_edge((time-v(tpf)*1u)/1e-07))'
Bren_ii ren_ii 0 V='v(vdd)*v(bsel_II)*af_edge((time-v(tren)*1u)/1e-07)'

* ---- legs on each band's global bit-line bus; ammeters read the leg currents ----
* i(vamp_<b>) > 0: program leg drives the bus.  i(vamr_<b>) < 0: bus sinks into the read leg.
Vamp_i blp_i BLG_I DC 0
Vamr_i blr_i BLG_I DC 0
Xpg_i pen_i ren_i vdd 0 blp_i vpp program_leg
Xrd_i pen_i ren_i vclamp iref_i vdd 0 blr_i sense_i rdata_i read_leg
Iref_i 0 iref_i DC 1e-06
Rbleed_i BLG_I 0 1e+10
* both-legs-on detector: min(PON, RON) (volts); 0 means never both ON
Bboth_i both_i 0 V='min(v(xpg_i.pon),v(xrd_i.ron))'
Vamp_ii blp_ii BLG_II DC 0
Vamr_ii blr_ii BLG_II DC 0
Xpg_ii pen_ii ren_ii vdd 0 blp_ii vpp program_leg
Xrd_ii pen_ii ren_ii vclamp iref_ii vdd 0 blr_ii sense_ii rdata_ii read_leg
Iref_ii 0 iref_ii DC 1e-06
Rbleed_ii BLG_II 0 1e+10
* both-legs-on detector: min(PON, RON) (volts); 0 means never both ON
Bboth_ii both_ii 0 V='min(v(xpg_ii.pon),v(xrd_ii.ron))'

* ---- assumed programmed-cell filament across the SELECTED cell's capacitor only ----
* (conductance = v(gfil); 0 = unprogrammed). Not a breakdown model.
Bfil_0_9 x_dut.xc_0_9.cn x_dut.pl_0_I I='v(x_dut.xc_0_9.cn,x_dut.pl_0_I)*v(gfil)*v(en_r0)*v(en_c9)'
Bfil_0_10 x_dut.xc_0_10.cn x_dut.pl_0_I I='v(x_dut.xc_0_10.cn,x_dut.pl_0_I)*v(gfil)*v(en_r0)*v(en_c10)'
Bfil_0_11 x_dut.xc_0_11.cn x_dut.pl_0_II I='v(x_dut.xc_0_11.cn,x_dut.pl_0_II)*v(gfil)*v(en_r0)*v(en_c11)'
Bfil_0_12 x_dut.xc_0_12.cn x_dut.pl_0_II I='v(x_dut.xc_0_12.cn,x_dut.pl_0_II)*v(gfil)*v(en_r0)*v(en_c12)'
Bfil_1_9 x_dut.xc_1_9.cn x_dut.pl_1_I I='v(x_dut.xc_1_9.cn,x_dut.pl_1_I)*v(gfil)*v(en_r1)*v(en_c9)'
Bfil_1_10 x_dut.xc_1_10.cn x_dut.pl_1_I I='v(x_dut.xc_1_10.cn,x_dut.pl_1_I)*v(gfil)*v(en_r1)*v(en_c10)'
Bfil_1_11 x_dut.xc_1_11.cn x_dut.pl_1_II I='v(x_dut.xc_1_11.cn,x_dut.pl_1_II)*v(gfil)*v(en_r1)*v(en_c11)'
Bfil_1_12 x_dut.xc_1_12.cn x_dut.pl_1_II I='v(x_dut.xc_1_12.cn,x_dut.pl_1_II)*v(gfil)*v(en_r1)*v(en_c12)'
Bfil_2_9 x_dut.xc_2_9.cn x_dut.pl_2_I I='v(x_dut.xc_2_9.cn,x_dut.pl_2_I)*v(gfil)*v(en_r2)*v(en_c9)'
Bfil_2_10 x_dut.xc_2_10.cn x_dut.pl_2_I I='v(x_dut.xc_2_10.cn,x_dut.pl_2_I)*v(gfil)*v(en_r2)*v(en_c10)'
Bfil_2_11 x_dut.xc_2_11.cn x_dut.pl_2_II I='v(x_dut.xc_2_11.cn,x_dut.pl_2_II)*v(gfil)*v(en_r2)*v(en_c11)'
Bfil_2_12 x_dut.xc_2_12.cn x_dut.pl_2_II I='v(x_dut.xc_2_12.cn,x_dut.pl_2_II)*v(gfil)*v(en_r2)*v(en_c12)'
Bfil_3_9 x_dut.xc_3_9.cn x_dut.pl_3_I I='v(x_dut.xc_3_9.cn,x_dut.pl_3_I)*v(gfil)*v(en_r3)*v(en_c9)'
Bfil_3_10 x_dut.xc_3_10.cn x_dut.pl_3_I I='v(x_dut.xc_3_10.cn,x_dut.pl_3_I)*v(gfil)*v(en_r3)*v(en_c10)'
Bfil_3_11 x_dut.xc_3_11.cn x_dut.pl_3_II I='v(x_dut.xc_3_11.cn,x_dut.pl_3_II)*v(gfil)*v(en_r3)*v(en_c11)'
Bfil_3_12 x_dut.xc_3_12.cn x_dut.pl_3_II I='v(x_dut.xc_3_12.cn,x_dut.pl_3_II)*v(gfil)*v(en_r3)*v(en_c12)'

* ---- stress probes: |V(a)-V(b)| of every terminal pair of every HV-exposed device ----
* (ngspice allows at most 99 par() calls and no v(a,b) in .meas, so each pair is a B source)
Bsp_st0gs sp_st0gs 0 V='abs(v(x_dut.wl_0_i)-v(x_dut.xc_0_9.cn))'
Bsp_st0gd sp_st0gd 0 V='abs(v(x_dut.wl_0_i)-v(x_dut.bl_9))'
Bsp_st0ds sp_st0ds 0 V='abs(v(x_dut.bl_9)-v(x_dut.xc_0_9.cn))'
Bsp_st1t12 sp_st1t12 0 V='abs(v(x_dut.xc_0_9.cn)-v(x_dut.pl_0_i))'
Bsp_st2gs sp_st2gs 0 V='abs(v(x_dut.wl_0_i)-v(x_dut.xc_0_10.cn))'
Bsp_st2gd sp_st2gd 0 V='abs(v(x_dut.wl_0_i)-v(x_dut.bl_10))'
Bsp_st2ds sp_st2ds 0 V='abs(v(x_dut.bl_10)-v(x_dut.xc_0_10.cn))'
Bsp_st3t12 sp_st3t12 0 V='abs(v(x_dut.xc_0_10.cn)-v(x_dut.pl_0_i))'
Bsp_st4gs sp_st4gs 0 V='abs(v(x_dut.wl_0_ii)-v(x_dut.xc_0_11.cn))'
Bsp_st4gd sp_st4gd 0 V='abs(v(x_dut.wl_0_ii)-v(x_dut.bl_11))'
Bsp_st4ds sp_st4ds 0 V='abs(v(x_dut.bl_11)-v(x_dut.xc_0_11.cn))'
Bsp_st5t12 sp_st5t12 0 V='abs(v(x_dut.xc_0_11.cn)-v(x_dut.pl_0_ii))'
Bsp_st6gs sp_st6gs 0 V='abs(v(x_dut.wl_0_ii)-v(x_dut.xc_0_12.cn))'
Bsp_st6gd sp_st6gd 0 V='abs(v(x_dut.wl_0_ii)-v(x_dut.bl_12))'
Bsp_st6ds sp_st6ds 0 V='abs(v(x_dut.bl_12)-v(x_dut.xc_0_12.cn))'
Bsp_st7t12 sp_st7t12 0 V='abs(v(x_dut.xc_0_12.cn)-v(x_dut.pl_0_ii))'
Bsp_st8gs sp_st8gs 0 V='abs(v(x_dut.wl_1_i)-v(x_dut.xc_1_9.cn))'
Bsp_st8gd sp_st8gd 0 V='abs(v(x_dut.wl_1_i)-v(x_dut.bl_9))'
Bsp_st8ds sp_st8ds 0 V='abs(v(x_dut.bl_9)-v(x_dut.xc_1_9.cn))'
Bsp_st9t12 sp_st9t12 0 V='abs(v(x_dut.xc_1_9.cn)-v(x_dut.pl_1_i))'
Bsp_st10gs sp_st10gs 0 V='abs(v(x_dut.wl_1_i)-v(x_dut.xc_1_10.cn))'
Bsp_st10gd sp_st10gd 0 V='abs(v(x_dut.wl_1_i)-v(x_dut.bl_10))'
Bsp_st10ds sp_st10ds 0 V='abs(v(x_dut.bl_10)-v(x_dut.xc_1_10.cn))'
Bsp_st11t12 sp_st11t12 0 V='abs(v(x_dut.xc_1_10.cn)-v(x_dut.pl_1_i))'
Bsp_st12gs sp_st12gs 0 V='abs(v(x_dut.wl_1_ii)-v(x_dut.xc_1_11.cn))'
Bsp_st12gd sp_st12gd 0 V='abs(v(x_dut.wl_1_ii)-v(x_dut.bl_11))'
Bsp_st12ds sp_st12ds 0 V='abs(v(x_dut.bl_11)-v(x_dut.xc_1_11.cn))'
Bsp_st13t12 sp_st13t12 0 V='abs(v(x_dut.xc_1_11.cn)-v(x_dut.pl_1_ii))'
Bsp_st14gs sp_st14gs 0 V='abs(v(x_dut.wl_1_ii)-v(x_dut.xc_1_12.cn))'
Bsp_st14gd sp_st14gd 0 V='abs(v(x_dut.wl_1_ii)-v(x_dut.bl_12))'
Bsp_st14ds sp_st14ds 0 V='abs(v(x_dut.bl_12)-v(x_dut.xc_1_12.cn))'
Bsp_st15t12 sp_st15t12 0 V='abs(v(x_dut.xc_1_12.cn)-v(x_dut.pl_1_ii))'
Bsp_st16gs sp_st16gs 0 V='abs(v(x_dut.wl_2_i)-v(x_dut.xc_2_9.cn))'
Bsp_st16gd sp_st16gd 0 V='abs(v(x_dut.wl_2_i)-v(x_dut.bl_9))'
Bsp_st16ds sp_st16ds 0 V='abs(v(x_dut.bl_9)-v(x_dut.xc_2_9.cn))'
Bsp_st17t12 sp_st17t12 0 V='abs(v(x_dut.xc_2_9.cn)-v(x_dut.pl_2_i))'
Bsp_st18gs sp_st18gs 0 V='abs(v(x_dut.wl_2_i)-v(x_dut.xc_2_10.cn))'
Bsp_st18gd sp_st18gd 0 V='abs(v(x_dut.wl_2_i)-v(x_dut.bl_10))'
Bsp_st18ds sp_st18ds 0 V='abs(v(x_dut.bl_10)-v(x_dut.xc_2_10.cn))'
Bsp_st19t12 sp_st19t12 0 V='abs(v(x_dut.xc_2_10.cn)-v(x_dut.pl_2_i))'
Bsp_st20gs sp_st20gs 0 V='abs(v(x_dut.wl_2_ii)-v(x_dut.xc_2_11.cn))'
Bsp_st20gd sp_st20gd 0 V='abs(v(x_dut.wl_2_ii)-v(x_dut.bl_11))'
Bsp_st20ds sp_st20ds 0 V='abs(v(x_dut.bl_11)-v(x_dut.xc_2_11.cn))'
Bsp_st21t12 sp_st21t12 0 V='abs(v(x_dut.xc_2_11.cn)-v(x_dut.pl_2_ii))'
Bsp_st22gs sp_st22gs 0 V='abs(v(x_dut.wl_2_ii)-v(x_dut.xc_2_12.cn))'
Bsp_st22gd sp_st22gd 0 V='abs(v(x_dut.wl_2_ii)-v(x_dut.bl_12))'
Bsp_st22ds sp_st22ds 0 V='abs(v(x_dut.bl_12)-v(x_dut.xc_2_12.cn))'
Bsp_st23t12 sp_st23t12 0 V='abs(v(x_dut.xc_2_12.cn)-v(x_dut.pl_2_ii))'
Bsp_st24gs sp_st24gs 0 V='abs(v(x_dut.wl_3_i)-v(x_dut.xc_3_9.cn))'
Bsp_st24gd sp_st24gd 0 V='abs(v(x_dut.wl_3_i)-v(x_dut.bl_9))'
Bsp_st24ds sp_st24ds 0 V='abs(v(x_dut.bl_9)-v(x_dut.xc_3_9.cn))'
Bsp_st25t12 sp_st25t12 0 V='abs(v(x_dut.xc_3_9.cn)-v(x_dut.pl_3_i))'
Bsp_st26gs sp_st26gs 0 V='abs(v(x_dut.wl_3_i)-v(x_dut.xc_3_10.cn))'
Bsp_st26gd sp_st26gd 0 V='abs(v(x_dut.wl_3_i)-v(x_dut.bl_10))'
Bsp_st26ds sp_st26ds 0 V='abs(v(x_dut.bl_10)-v(x_dut.xc_3_10.cn))'
Bsp_st27t12 sp_st27t12 0 V='abs(v(x_dut.xc_3_10.cn)-v(x_dut.pl_3_i))'
Bsp_st28gs sp_st28gs 0 V='abs(v(x_dut.wl_3_ii)-v(x_dut.xc_3_11.cn))'
Bsp_st28gd sp_st28gd 0 V='abs(v(x_dut.wl_3_ii)-v(x_dut.bl_11))'
