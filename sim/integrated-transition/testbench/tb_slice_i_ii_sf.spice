Bsp_st42gs sp_st42gs 0 V='abs(v(csel_11)-v(0))'
Bsp_st42gd sp_st42gd 0 V='abs(v(csel_11)-v(x_dut.cgb_11))'
Bsp_st42ds sp_st42ds 0 V='abs(v(x_dut.cgb_11)-v(0))'
Bsp_st43gs sp_st43gs 0 V='abs(v(x_dut.xlc_11.inb)-v(0))'
Bsp_st43gd sp_st43gd 0 V='abs(v(x_dut.xlc_11.inb)-v(x_dut.cg_11))'
