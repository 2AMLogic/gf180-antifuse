Bsp_st30gs sp_st30gs 0 V='abs(v(x_dut.wl_3_ii)-v(x_dut.xc_3_12.cn))'
Bsp_st30gd sp_st30gd 0 V='abs(v(x_dut.wl_3_ii)-v(x_dut.bl_12))'
