Bsp_st31t12 sp_st31t12 0 V='abs(v(x_dut.xc_3_12.cn)-v(x_dut.pl_3_ii))'
Bsp_st32gs sp_st32gs 0 V='abs(v(csel_9)-v(0))'
Bsp_st32gd sp_st32gd 0 V='abs(v(csel_9)-v(x_dut.cgb_9))'
Bsp_st32ds sp_st32ds 0 V='abs(v(x_dut.cgb_9)-v(0))'
Bsp_st33gs sp_st33gs 0 V='abs(v(x_dut.xlc_9.inb)-v(0))'
Bsp_st33gd sp_st33gd 0 V='abs(v(x_dut.xlc_9.inb)-v(x_dut.cg_9))'
