#### Project xschemrc for gf180-antifuse design sources.
####
#### Use it either by starting xschem from this directory (xschem picks up
#### ./xschemrc automatically) or explicitly:
####
####   PDK_ROOT=$HOME/.volare xschem --rcfile design/xschemrc design/cells/cell_candidate1.sch
####
#### design/regen-netlists.sh passes it explicitly, so netlist regeneration
#### does not depend on the invoking shell's cwd or on ~/.xschem/xschemrc.

#### Inherit the PDK's own xschemrc: device symbol library path, model path
#### ($::180MCU_MODELS), and PDK-specific defaults. It requires PDK_ROOT.
if { ![info exists env(PDK_ROOT)] || $env(PDK_ROOT) eq {} } {
  puts stderr "gf180-antifuse xschemrc: PDK_ROOT is not set."
  puts stderr "Set it to the volare/open_pdks install root that contains gf180mcuD/."
  exit 1
}
source $env(PDK_ROOT)/gf180mcuD/libs.tech/xschem/xschemrc

#### Make this repo's own cells resolvable by bare name (cell_candidate1.sym).
set GF180_ANTIFUSE_DESIGN_DIR [file dirname [file normalize [info script]]]
append XSCHEM_LIBRARY_PATH :${GF180_ANTIFUSE_DESIGN_DIR}/cells

#### Write one file per subcircuit when netlisting. design/cells/cell_library.sch
#### relies on this to emit one derived netlist per cell schematic.
set split_files 1

#### Do not open the PDK's device-showcase schematic when started with no file.
set XSCHEM_START_WINDOW {}
