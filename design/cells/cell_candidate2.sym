v {xschem version=3.4.7 file_version=1.2

* gf180-antifuse: symbol for the Candidate 2 (high-voltage) antifuse cell.
*
* Parameters:
*   wcap, lcap - capacitor (antifuse element) width and length. Split axis
*                per spec/split-axis-plan.md; the values below are the PDK
*                cap_nmos_06v0 symbol template defaults, carried through
*                verbatim as placeholders. They are NOT a process-minimum
*                claim - that minimum (1.0 x 0.70 um for cap_nmos_06v0) is
*                ratified in spec/capacitor-geometry-decision.md; the
*                minimum-legal access geometry (wacc/lacc) is still a PDK
*                design-rule lookup with no ratified record behind it.
*   wacc, lacc - access-device width and length, same placeholder rule
*                (nfet_10v0_asym symbol template defaults). Per
*                spec/split-axis-plan.md this region's sizing axis varies
*                width only, at the HV module's fixed minimum length.
*
* BL connects to the access device's DRAIN (the drain-extended,
* high-voltage-blocking terminal). See cell_candidate2.sch.
}
G {}
K {type=subcircuit
format="@name @pinlist @symname wcap=@wcap lcap=@lcap wacc=@wacc lacc=@lacc m=@m"
template="name=x1 wcap=1e-6 lcap=1e-6 wacc=25u lacc=0.60u m=1"
}
V {}
S {}
E {}
L 4 -60 -60 60 -60 {}
L 4 -60 60 60 60 {}
L 4 -60 -60 -60 60 {}
L 4 60 -60 60 60 {}
L 4 -80 -30 -60 -30 {}
L 4 -80 30 -60 30 {}
L 4 60 -30 80 -30 {}
L 4 60 30 80 30 {}
B 5 -82.5 -32.5 -77.5 -27.5 {name=BL dir=inout}
B 5 -82.5 27.5 -77.5 32.5 {name=WL dir=in}
B 5 77.5 -32.5 82.5 -27.5 {name=PL dir=inout}
B 5 77.5 27.5 82.5 32.5 {name=VB dir=inout}
T {@symname} -52 -5 0 0 0.3 0.3 {}
T {@name} -60 -75 0 0 0.25 0.25 {}
T {BL - LDNMOS drain} -55 -35 0 0 0.25 0.25 {}
T {WL} -55 25 0 0 0.25 0.25 {}
T {PL} 35 -35 0 0 0.25 0.25 {}
T {VB} 35 25 0 0 0.25 0.25 {}
T {cap_nmos_06v0 + nfet_10v0_asym} -60 40 0 0 0.22 0.22 {}
