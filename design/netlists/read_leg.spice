XMPO SENSE PIN VDD VDD pfet_03v3 L=lmp W=wmp nf=1 ad='int((nf+1)/2) * wmp/nf * 0.18u' as='int((nf+2)/2) * wmp/nf * 0.18u' pd='2*int((nf+1)/2) * (wmp/nf + 0.18u)' ps='2*int((nf+2)/2) * (wmp/nf + 0.18u)' nrd='0.18u / wmp' nrs='0.18u / wmp' sa=0 sb=0 sd=0 m=1
XMNI IREF IREF VSS VSS nfet_03v3 L=lmn W=wmn nf=1 ad='int((nf+1)/2) * wmn/nf * 0.18u' as='int((nf+2)/2) * wmn/nf * 0.18u' pd='2*int((nf+1)/2) * (wmn/nf + 0.18u)' ps='2*int((nf+2)/2) * (wmn/nf + 0.18u)' nrd='0.18u / wmn' nrs='0.18u / wmn' sa=0 sb=0 sd=0 m=1
XMNO SENSE IREF VSS VSS nfet_03v3 L=lmn W=wmn nf=1 ad='int((nf+1)/2) * wmn/nf * 0.18u' as='int((nf+2)/2) * wmn/nf * 0.18u' pd='2*int((nf+1)/2) * (wmn/nf + 0.18u)' ps='2*int((nf+2)/2) * (wmn/nf + 0.18u)' nrd='0.18u / wmn' nrs='0.18u / wmn' sa=0 sb=0 sd=0 m=1
XMN6 SB SENSE VSS VSS nfet_03v3 L=lg W=wnl nf=1 ad='int((nf+1)/2) * wnl/nf * 0.18u' as='int((nf+2)/2) * wnl/nf * 0.18u' pd='2*int((nf+1)/2) * (wnl/nf + 0.18u)' ps='2*int((nf+2)/2) * (wnl/nf + 0.18u)' nrd='0.18u / wnl' nrs='0.18u / wnl' sa=0 sb=0 sd=0 m=1
